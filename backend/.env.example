# Copy to .env and fill in real values locally / set these in your host's
# environment variable settings for deployment. Never commit the real .env.

MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<db-name>
PORT=5000

# Set to "production" on Render — this drives cookie Secure/SameSite flags
# and whether error responses include internal error details.
NODE_ENV=development

# Real deployed URLs of the customer frontend and Admin panel (CORS allowlist).
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:5173

# Cloudflare R2
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# JWT — generate distinct random secrets, e.g.:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRES_IN_MINUTES=15
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Used only by `npm run seed:admin` / `npm run update:admin` — not read at
# request time, so rotating the admin password doesn't require redeploying,
# just re-running `npm run update:admin` with the new value.
ADMIN_EMAIL=
ADMIN_PASSWORD=
